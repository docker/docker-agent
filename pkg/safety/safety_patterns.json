      { "pattern": "du -sh <path>", "category": "fs-read", "notes": "single-path summary; non-recursive write" },
      { "pattern": "tree",          "category": "fs-read", "notes": "directory listing" },
      { "pattern": "tree <path>",   "category": "fs-read", "notes": "directory listing" },
      { "pattern": "ls ...", "category": "fs-read" },
      { "pattern": "cat ...", "category": "fs-read" },
      { "pattern": "wc ...", "category": "fs-read" },
      { "pattern": "head -<number>", "category": "fs-read" },
      { "pattern": "head -<number> <read-path>", "category": "fs-read" },
      { "pattern": "head -c <number>", "category": "fs-read" },
