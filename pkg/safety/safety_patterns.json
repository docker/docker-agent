      { "pattern": "head -n <n> <file>", "category": "fs-read", "notes": "bounded prefix" },
      { "pattern": "tail <file>",   "category": "fs-read", "notes": "suffix read" },
      { "pattern": "tail -n <n> <file>", "category": "fs-read", "notes": "bounded suffix" },
      { "pattern": "pwd",           "category": "fs-read", "notes": "print working directory" },
      { "pattern": "stat <file>",   "category": "fs-read", "notes": "inode metadata" },
      { "pattern": "file <file>",   "category": "fs-read", "notes": "type sniff" },
      { "pattern": "wc <file>",     "category": "fs-read", "notes": "line/word/char count" },
