{
  "name": "@docker/docker-agent-ts-sdk",
  "version": "0.0.0-dev",
  "description": "TypeScript types for the docker-agent API, generated from its Go source",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docker/docker-agent.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
